# Copy to backend/.env and replace placeholders with your local PostgreSQL details.
# URL-encode special characters in the password (for example @ becomes %40).
DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/car_dealership_dev
TEST_DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/car_dealership_test
JWT_SECRET=REPLACE_WITH_A_RANDOM_SECRET
FRONTEND_ORIGIN=http://localhost:5173

